{
  "name": "tablet-kiosk",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
  "description": "Weather kiosk app for repurposed Android tablet with moon phase visualization",
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/clearing-three/tablet-kiosk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clearing-three/tablet-kiosk.git"
  },
  "bugs": {
    "url": "https://github.com/clearing-three/tablet-kiosk/issues"
  },
  "keywords": [],
  "main": "dist/index.html",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"**/*.css\"",
    "stylelint:fix": "stylelint \"**/*.css\" --fix",
    "type-check": "tsc --noEmit",
    "analyze:lit": "lit-analyzer 'src/**/*.ts'",
    "validate": "pnpm lint:fix && pnpm stylelint:fix && pnpm lint && pnpm stylelint && pnpm analyze:lit && pnpm test && pnpm build",
    "deploy": "./deploy.sh",
    "deploy:list": "./deploy.sh -l",
    "deploy:clean": "./deploy.sh -c",
    "knip": "knip"
  },
  "dependencies": {
    "@lit/context": "1.1.6",
    "lit": "3.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-wc": "3.1.0",
    "happy-dom": "20.14.0",
    "jsdom": "30.0.1",
    "knip": "6.34.0",
    "lit-analyzer": "2.0.3",
    "only-allow": "1.2.2",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
