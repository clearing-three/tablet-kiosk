{
  "name": "tablet-kiosk",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "description": "Weather kiosk app for repurposed Android tablet with moon phase visualization",
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/clearing-three/tablet-kiosk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clearing-three/tablet-kiosk.git"
  },
  "bugs": {
    "url": "https://github.com/clearing-three/tablet-kiosk/issues"
  },
  "keywords": [],
  "main": "dist/index.html",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"**/*.css\"",
    "stylelint:fix": "stylelint \"**/*.css\" --fix",
    "type-check": "tsc --noEmit",
    "analyze:lit": "lit-analyzer 'src/**/*.ts'",
    "validate": "pnpm lint:fix && pnpm stylelint:fix && pnpm lint && pnpm stylelint && pnpm analyze:lit && pnpm test && pnpm build",
    "deploy": "./deploy.sh",
    "deploy:list": "./deploy.sh -l",
    "deploy:clean": "./deploy.sh -c",
    "knip": "knip"
  },
  "dependencies": {
    "@lit/context": "1.1.6",
    "lit": "3.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-wc": "3.1.0",
    "happy-dom": "20.11.2",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "lit-analyzer": "2.0.3",
    "only-allow": "1.2.2",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
